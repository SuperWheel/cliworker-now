{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  }
}
